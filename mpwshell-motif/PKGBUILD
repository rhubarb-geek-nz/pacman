# Maintainer: rhubarb-geek-nz@users.sourceforge.net
pkgname=mpwshell-motif
pkgver=0.9.6
pkgrel=1
epoch=
pkgdesc="Motivated Power Shell - text editor with embedded scripting engine"
arch=("$CARCH")
url="https://github.com/rhubarb-geek-nz/MPWShell"
license=('MIT')
groups=()
depends=('powershell')
makedepends=('openmotif' 'libxpm')
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=
changelog=
noextract=()
md5sums=()
validpgpkeys=()
source=("https://github.com/rhubarb-geek-nz/MPWShell/archive/refs/tags/0.9.6.tar.gz")
sha256sums=("cbd9e4b1497f1e82d191ec33b0c4c4cbd4547ddf2bd2b73048fbd3eabfd5e453")

build() {
	cd "MPWShell-0.9.6/Motif"
	CFLAGS="-Wall -Werror $CFLAGS" make
}

check() {
	test -x "MPWShell-0.9.6/Motif/mpwshell"
}

package() {
	mkdir -p "$pkgdir/usr/bin"
	cp "MPWShell-0.9.6/Motif/mpwshell" "$pkgdir/usr/bin/mpwshell"
}
